node_modules/
dist/
*.tsbuildinfo
*.tgz
.DS_Store

# Running an oracle makes the real Claude Code binary write its own state into
# the fixture's sandboxed home — a machineID and userID in .claude.json, and a
# session transcript per probe under projects/. None of it may be committed.
#
# Allowlist, not blocklist: ignore everything under the fixture's .claude/ and
# re-admit only the files we deliberately author. A blocklist here already
# missed projects/ once, and would miss whatever the binary writes next.
test/fixtures/**/.fake-home/.claude.json
test/fixtures/**/.fake-home/.claude/*
!test/fixtures/**/.fake-home/.claude/settings.json
!test/fixtures/**/.fake-home/.claude/settings.local.json
!test/fixtures/**/.fake-home/.claude/CLAUDE.md

# Scratch output of the hook oracle. The recording in .conformance/ is the
# committed artifact; this is just the raw probe log.
test/fixtures/**/.hooklog

# Committed on purpose — these are the expectations CI replays:
#   test/fixtures/**/.conformance/
#   test/fixtures/**/.oracle.json
# and the fixtures need their own local settings layer to test against:
#   test/fixtures/**/settings.local.json

# Vitest JSON report, written by `npm run test:strict` to verify that every
# suite actually ran. Regenerated per run; never an artifact.
.vitest/
