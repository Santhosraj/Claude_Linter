{
  "name": "@santhosraj/cclint",
  "version": "0.2.2",
  "description": "Lint CLAUDE.md, hooks, and MCP config for silent conflicts, dead references, and token bloat.",
  "type": "module",
  "bin": {
    "cclint": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./cli": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "conformance:record": "tsx scripts/record-conformance.ts",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Santhosraj/Claude_Linter.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "lint",
    "linter",
    "CLAUDE.md",
    "hooks",
    "mcp",
    "config"
  ],
  "homepage": "https://github.com/Santhosraj/Claude_Linter#readme",
  "bugs": {
    "url": "https://github.com/Santhosraj/Claude_Linter/issues"
  }
}
