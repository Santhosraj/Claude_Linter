{
  "model": "claude-sonnet-5",
  "permissions": {
    "allow": ["Bash(git status)", "Read(**)"],
    "defaultMode": "acceptEdits"
  },
  "env": {
    "PROJECT_SCOPE": "shared"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/scripts/audit.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [{ "type": "command", "command": "prettier --write" }]
      }
    ],
    "OnFileSave": [
      {
        "matcher": "Write",
        "hooks": [{ "type": "command", "command": "echo saved" }]
      }
    ]
  }
}
